# ============================================================
# PanSou Modern Web —— 纯前端部署环境变量
# ------------------------------------------------------------
# cp .env.example .env
# chmod 600 .env        # 里面可能含内网地址/凭据，别用默认权限
# ============================================================

# ---------- 镜像 ----------
# 默认拉取本项目 GitHub Actions 构建的镜像。
# 固定版本时建议写具体 tag（例如 :sha-1a2b3c4 或 :v1.0.0），
# 避免 docker compose pull 时被 latest 悄悄升级。
PANSOU_FRONTEND_IMAGE=ghcr.io/jin66god/pansou-modern-web:latest

# 容器名（一台机器跑多套时可以改）
PANSOU_CONTAINER_NAME=pansou-modern-web

# ---------- 端口 ----------
# 只监听本机，外网通过 OpenResty / Nginx 反代进来
PANSOU_FRONTEND_BIND=127.0.0.1
PANSOU_FRONTEND_PORT=13080

# ---------- 关键：后端地址 ----------
# 后端 PanSou 服务地址，前端容器的 Nginx 会把下面这些路径原样转发过去：
#   /api/*     核心接口（搜索、健康检查、JWT 登录、链接检测）
#   /qqpd/*    QQ 频道插件管理页
#   /weibo/*   微博插件管理页
#   /gying/*   观影插件管理页
#   /panlian/* 盘链插件管理页
#
# 常见取值：
#   后端跑在宿主机（最常见）      http://host.docker.internal:8890
#   后端是同 compose 网络里的容器  http://pansou:80
#   后端在另一台机器              http://10.0.0.12:8890
#
# 注意：地址里不要带结尾斜杠，也不要带 /api 后缀。
PANSOU_BACKEND_URL=http://host.docker.internal:8890

# ---------- 反代参数 ----------
# 搜索请求后端要并发抓取，可能 20~60 秒，网关读超时给足
PANSOU_PROXY_READ_TIMEOUT=180s
# 请求体上限（链接检测批量提交、插件扩展 JSON）
PANSOU_CLIENT_MAX_BODY_SIZE=8m

# ---------- 时区 ----------
TZ=Asia/Shanghai
