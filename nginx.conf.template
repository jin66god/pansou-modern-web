# ============================================================
# PanSou Modern Web —— 纯前端 Nginx 配置模板
# ------------------------------------------------------------
# 该文件由 nginx 官方镜像的 docker-entrypoint 在容器启动时
# 用 envsubst 渲染为 /etc/nginx/conf.d/default.conf。
# 只有下面这几个「已定义的环境变量」会被替换，
# nginx 自带变量（$host / $uri / $remote_addr 等）不会被误替换。
#
#   PANSOU_BACKEND_URL           后端 PanSou 服务地址（必填）
#   PANSOU_PROXY_READ_TIMEOUT    反代读超时，搜索是长请求，建议 >=180s
#   PANSOU_CLIENT_MAX_BODY_SIZE  请求体上限（链接检测批量提交用）
# ============================================================

server {
    listen       80;
    listen  [::]:80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    charset       utf-8;
    server_tokens off;
    client_max_body_size ${PANSOU_CLIENT_MAX_BODY_SIZE};

    # ---------- 压缩 ----------
    gzip              on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_vary         on;
    gzip_types        text/plain text/css text/xml application/json
                      application/javascript application/xml+rss
                      application/atom+xml image/svg+xml;

    # ---------- 安全响应头 ----------
    add_header X-Content-Type-Options    nosniff                        always;
    add_header X-Frame-Options           SAMEORIGIN                     always;
    add_header Referrer-Policy           strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin                   always;

    # ---------- 反代公共参数（对下面所有 location 生效） ----------
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host  $host;
    proxy_set_header   Upgrade           $http_upgrade;
    proxy_set_header   Connection        "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    ${PANSOU_PROXY_READ_TIMEOUT};
    proxy_read_timeout    ${PANSOU_PROXY_READ_TIMEOUT};
    # 搜索接口可能持续 20~60 秒，关闭缓冲让浏览器尽早拿到响应
    proxy_buffering       off;

    # ---------- 后端地址的解析时机 ----------
    # 下面的 proxy_pass 直接写后端地址，这是刻意的选择：
    # nginx 会在「容器启动时」解析一次该主机名（走 /etc/hosts + /etc/resolv.conf），
    # 所以 compose 里的 extra_hosts（host.docker.internal -> 宿主网关）
    # 和同网络容器名都能正常工作。
    #
    # 代价：如果这个主机名解析失败，nginx 会直接 emerg 退出、容器起不来，
    # 日志里会明确写 "host not found in upstream"。排查办法见 README「故障排查」，
    # 拿不准时把 PANSOU_BACKEND_URL 换成宿主机的 IP。
    #
    # 不要改成 "$变量 + resolver 127.0.0.11" 的写法：这样虽然能延迟到请求时解析，
    # 但在没有 Docker 内置 DNS 的环境（部分嵌套容器 / 自定义 daemon 配置）里
    # 会导致所有代理请求都失败，反而更难排查。

    # ---------- 容器自身存活探针（不依赖后端） ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # ---------- 后端核心 API ----------
    # /api/search、/api/health、/api/auth/*、/api/check/links
    location /api/ {
        proxy_pass ${PANSOU_BACKEND_URL}/api/;
    }

    # ---------- 插件自带的管理页面 ----------
    # 这些路由由后端插件注册（plugin/*/RegisterWebRoutes），
    # 只有插件启用且实现 PluginWithWebHandler 时才存在。
    #   /qqpd/:hash      QQ 频道插件
    #   /weibo/:hash     微博插件
    #   /gying/:hash     观影插件
    #   /panlian/:hash   盘链插件
    location /qqpd/ {
        proxy_pass ${PANSOU_BACKEND_URL}/qqpd/;
    }

    location /weibo/ {
        proxy_pass ${PANSOU_BACKEND_URL}/weibo/;
    }

    location /gying/ {
        proxy_pass ${PANSOU_BACKEND_URL}/gying/;
    }

    location /panlian/ {
        proxy_pass ${PANSOU_BACKEND_URL}/panlian/;
    }

    # ---------- 静态资源 ----------
    # 构建产物带内容 hash，可以长缓存
    location /assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # 图标等少量固定文件，短缓存
    location ~* \.(?:ico|png|jpe?g|webp|svg|gif|woff2?|ttf|eot)$ {
        access_log off;
        expires    7d;
        add_header Cache-Control "public";
        try_files  $uri =404;
    }

    # ---------- SPA 兜底 ----------
    # index.html 绝不能缓存，否则前端发版后用户拿到旧壳
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- 错误页 ----------
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
